// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One finished practice-quiz run (timed challenge or infinite mode).
// `misses` stores a JSON array of missed questions:
//   [{ verb, subject, tense, kind, given, expected, userAnswer }]
// `tally` stores a JSON map of per-tense answers: tense → { c, t }
model PracticeSession {
  id               String   @id @default(cuid())
  mode             String // "timed" | "infinite"
  durationSec      Int
  score            Int
  total            Int
  accuracy         Float // 0..1
  bestStreak       Int
  avgMsPerQuestion Int
  accentWarnings   Int      @default(0)
  misses           String   @default("[]") // JSON array
  tally            String   @default("{}") // JSON map: tense → { c, t }
  createdAt        DateTime @default(now())
}

// A claimed "streak freeze" (seguro de racha): the user missed
// exactly one day right after a live streak; the freeze keeps the
// racha alive. Max one freeze per rolling 7-day window.
model StreakFreeze {
  id        String   @id @default(cuid())
  // the calendar day (local server midnight) that was frozen
  frozenFor DateTime
  createdAt DateTime @default(now())
}
